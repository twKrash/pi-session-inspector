{
  "name": "pi-session-inspector",
  "version": "0.10.0",
  "description": "Deterministic local-only session analytics for Pi",
  "type": "module",
  "license": "MIT",
  "author": "twKrash",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/twKrash/pi-session-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/twKrash/pi-session-inspector/issues"
  },
  "homepage": "https://github.com/twKrash/pi-session-inspector#readme",
  "keywords": [
    "pi-package",
    "pi",
    "observability",
    "session-analytics"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:invariants": "node --import tsx --test tests/invariants/*.test.ts",
    "benchmark:smoke": "node --expose-gc --import tsx benchmark/run.ts --mode=smoke",
    "benchmark:release": "node --expose-gc --import tsx benchmark/run.ts --mode=release --out=benchmark/artifacts/release-latest.json",
    "knip": "knip",
    "prepare": "node scripts/install-hooks.mjs",
    "depcruise": "depcruise --config .dependency-cruiser.cjs --output-type err src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^22.19.7",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.0",
    "knip": "^6.35.1",
    "tsx": "4.21.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "^0.85.1"
  },
  "dependencies": {
    "publint": "^0.3.24"
  }
}
